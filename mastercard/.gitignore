# Secrets — do not commit
.env
.env.*
# ...except the value-less template
!.env.example

# Mastercard crypto material (keys and certificates)
certs/
*.p12
*.pem
*.key

# Local merchant secrets (dev SecretStore)
secrets.local.json

# Build / dependencies
dist/
node_modules/

# Test coverage
coverage/

# Logs and temporary artifacts
*.log
startup*.log
*.out
*.tmp

# agentic-security scanner output/cache (tooling, not versioned)
.agentic-security/

# Connectivity-report runs: real sandbox request/response payloads and the
# generated report. Deliverables for Mastercard, not source — kept out of the
# public repo. The scripts that produce them ARE versioned.
reports/

# Internal dev/process docs — kept locally, not versioned
docs/*/memory.md
docs/*/plan.md
docs/*/issues.md
docs/*/tests.md
docs/*/tests-inner.md
docs/*/client-questions.md
docs/*/fund-operations.md
docs/*/Carded-Rates-plan.md

# Mastercard's OWN documentation — NEVER versioned. This repository is PUBLIC, and
# these are Mastercard's materials, not ours:
#   additional/            the Product Guide and Technical Deep Dive Workshop sent to
#                          us directly, both stamped "Proprietary and Confidential",
#                          plus real API and report samples;
#   api-mastercard-oauth2/ and mc-oauth2/
#                          pages mirrored from developer.mastercard.com.
# Read them locally; cite them by page in our own docs instead of copying them in.
docs/*/additional/
docs/*/api-mastercard-oauth2/
docs/*/mc-oauth2/
