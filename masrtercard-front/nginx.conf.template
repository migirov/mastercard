# nginx config TEMPLATE. `docker-entrypoint.sh` runs envsubst over it with an explicit
# variable list — ${APP_BFF_URL} and ${MASTERCARD_BFF_URL} only — and writes the result to
# /etc/nginx/conf.d/default.conf. The explicit list is what keeps nginx's own runtime
# variables ($host, $remote_addr, $uri) from being substituted away to empty strings.
#
# The two upstreams are variables, not hardcoded service names, because the published image
# has to run wherever the operator puts the backends (compose service names, ECS service
# discovery, a k8s Service). Defaults match the compose stack.
server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # --- Security headers -------------------------------------------------------------------
  # Server-level so they also cover the /demo-api/* proxy locations (nginx inherits add_header
  # into a location only when that location declares none of its own; those declare only
  # proxy_set_header). `always` so they are emitted on error responses too.
  #
  # CSP shipped as Report-Only first and is now ENFORCING. Two things cleared it: a walk of
  # the dashboard, the full payment flow, the live Features pages and RFI with devtools open
  # (clean console), and a scan of the built bundle for every external origin it references --
  # fonts.googleapis.com, images.unsplash.com and upload.wikimedia.org are the only ones that
  # are actually fetched, and all three are allowed below. github.com / reactjs.org /
  # radix-ui.com appear as link targets (navigation, which this policy does not restrict) and
  # www.w3.org is the SVG xmlns, not a request.
  #
  # To roll back in a hurry: rename this header to Content-Security-Policy-Report-Only and
  # rebuild the frontend image. Violations then log to the console instead of blocking.
  #
  # Directive notes, because two of these look wrong and are not:
  #  - style-src 'unsafe-inline' is UNAVOIDABLE: Radix/react-remove-scroll inject <style> at
  #    runtime, and a nonce is impossible behind a statically-served build (try_files).
  #  - fonts.googleapis.com is required because the @import in index.css survives into the
  #    built CSS; fonts.gstatic.com serves the font files themselves.
  #  - frame-src is deliberately broad: the invoice viewer frames customer-supplied document
  #    URLs. The containment for that frame is its sandbox="" attribute, not this directive.
  #  - script-src stays 'self': the built index.html has no inline script. The runtime
  #    /config.js is a same-origin FILE (written by the entrypoint), not inline, so 'self'
  #    covers it. If a dynamic import is ever added, Vite emits an inline modulepreload
  #    polyfill and this would break the app.
  add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://images.unsplash.com https://upload.wikimedia.org; connect-src 'self'; frame-src https:; media-src 'none'; worker-src 'none'" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;

  # Container liveness. Public and cheap by design — it is the only route an orchestrator
  # (docker HEALTHCHECK, an ALB target group, a k8s probe) needs, and it reveals nothing.
  location = /healthz {
    access_log off;
    add_header Content-Type text/plain;
    return 200 "ok\n";
  }

  # The runtime config carries the deployment's API token, and unlike the hashed bundle assets
  # its URL never changes — so it must never be cached, or a redeployed token would be masked
  # by a stale copy in a browser or an intermediary.
  location = /config.js {
    add_header Cache-Control "no-store" always;
    try_files $uri =404;
  }

  # The SPA calls the BFFs under /demo-api/* (DEMO_API_URL=/demo-api). nginx splits the
  # path between the two backends (same-origin for the browser, so no CORS). The trailing
  # slash on proxy_pass strips the matched prefix. Most specific location wins:
  #   /demo-api/xbs/*      + /demo-api/features/*  → mastercard-bff (cross-border layer)
  #   everything else under /demo-api/*            → app-bff       (entities/auth/integrations)

  # Cross-border (Mastercard) — the /xbs and /features API.
  location /demo-api/xbs/ {
    proxy_pass http://${MASTERCARD_BFF_URL}/xbs/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    client_max_body_size 5m;
  }
  location /demo-api/features/ {
    proxy_pass http://${MASTERCARD_BFF_URL}/features/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    client_max_body_size 5m;
  }

  # App data (entities / auth.me / integrations) — the permanent frontend backend.
  location /demo-api/ {
    proxy_pass http://${APP_BFF_URL}/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    client_max_body_size 5m;
  }

  # Client-side routed SPA: fall back to index.html for unknown paths.
  location / {
    try_files $uri $uri/ /index.html;
  }
}
