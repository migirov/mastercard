# Frontend (Vite) configuration template. Copy to `.env` for `npm run dev`.
#
# These two are the LOCAL-DEV path only: they are inlined into the bundle at build time and act
# as the fallback in src/api/demoApi.js. A container ignores them — the image reads
# DEMO_API_TOKEN / DEMO_API_URL from its environment at START (docker-entrypoint.sh), which is
# what keeps one published image usable in every environment and free of any token.

# Where the SPA sends its API calls. `/demo-api` is the nginx-proxied same-origin path used in
# the compose stack; point it at a BFF directly when running the two apart.
VITE_DEMO_API_URL=/demo-api

# Shared bearer token both BFFs require (`Authorization: Bearer <token>`). MUST equal
# DEMO_API_TOKEN in mastercard-demo-stack/.env, or every API call returns 401.
#
# This value ends up in the built JavaScript and is therefore readable by anyone who can load
# the app. It is a boundary against unauthenticated access to the APIs, not a user secret — and on
# its own it is not sufficient: both BFFs also require the access-gate proof, which app-bff mints
# only after checking DEMO_GATE_PASSWORD. See below.
VITE_DEMO_API_TOKEN=replace-with-a-random-token

# --- The access-gate password is NOT a frontend variable -------------------------------------
#
# There is deliberately no key below to fill in. The password typed into the UI's gate screen is
# verified SERVER-SIDE (`POST /demo-api/gate/verify` in app-bff, which checks DEMO_GATE_PASSWORD
# from its own environment). It must never reach this bundle: it used to be a constant in
# src/components/PasswordGate.jsx, Vite inlined it into dist/assets/index-*.js, and it therefore
# shipped inside the published image where anyone who could load the app could read it.
#
# For `npm run dev` you need a running app-bff with DEMO_GATE_PASSWORD set — see app-bff/.env.example.
# With no backend reachable the gate screen says "Cannot reach the server" rather than accepting
# anything locally.
