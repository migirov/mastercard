# mastercard-bff configuration. All vars are optional — the defaults target the sibling
# gateway service `app`. This BFF is STATELESS (no database): it only proxies cross-border
# calls to the Mastercard gateway (live) or synthesizes them (demo), per capability.

# --- runtime ---
NODE_ENV=development
PORT=4000

# --- API authentication (REQUIRED) ---
# Shared bearer token every caller must send as `Authorization: Bearer <token>`.
# Only /health is public (docker-compose's healthcheck depends on that).
# Unset = every request 401s; in production the service refuses to start at all.
# This one guards routes that reach the real Mastercard sandbox with the platform's key.
# On its own it is NOT SUFFICIENT — every route also needs a gate proof (DEMO_GATE_SECRET below).
# Generate one with:  openssl rand -base64 32
DEMO_API_TOKEN=replace-with-a-random-token

# HMAC key for the access-gate proof, the second factor every route requires.
#
# This service only VERIFIES proofs — app-bff mints them, in POST /gate/verify, after checking the
# gate password. So there is no DEMO_GATE_PASSWORD here and no TTL setting: nothing in this service
# decides how long a proof lives, it only checks the expiry that was signed into one.
#
# ⚠️ MUST be byte-identical to app-bff's DEMO_GATE_SECRET. On drift, the dashboard keeps working
# while every cross-border page 401s.
# Unset = every route except /health 401s; in production the service refuses to start.
DEMO_GATE_SECRET=replace-with-a-random-secret

# Comma-separated browser origins allowed to call this API cross-origin. Unset defaults to
# Vite's dev server (http://localhost:5173, http://127.0.0.1:5173). Irrelevant in the compose
# stack, where the SPA reaches this service same-origin through nginx.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- cross-border gateway (sibling `mastercard` service) ---
GATEWAY_URL=http://app:3000
GATEWAY_INTERNAL_TOKEN=
# The gateway's baseline ACTIVE tenant (seeded on boot). Live calls 404 with an unseeded id.
GATEWAY_TENANT_ID=platform

# --- per-capability live|demo switch (defaults in parens) ---
XBS_QUOTE_MODE=demo          # (demo) — sandbox returns a stub rate (777)
XBS_VALIDATION_MODE=live     # (live)
XBS_BALANCES_MODE=live       # (live)
XBS_PAYMENT_MODE=demo        # (demo) — needs MTF/Prod
XBS_STATUS_MODE=demo         # (demo) — needs MTF/Prod

# --- per-feature live|demo switch (the "Features" pages) ---
XBS_BANK_LOOKUP_MODE=live    # (live)
XBS_IBAN_MODE=live           # (live)
XBS_CASH_PICKUP_MODE=live    # (live)
XBS_RATES_MODE=demo          # (demo)
XBS_ENDPOINT_GUIDE_MODE=demo # (demo)
XBS_QUOTE_LIFECYCLE_MODE=demo
XBS_PAYMENT_TRACKER_MODE=demo
XBS_RFI_MODE=demo
