# mastercard-demo-stack — environment template. Copy to `.env` and fill in.
# The real `.env` is git-ignored (it carries a shared secret).

# Internal token the BFFs present to the gateway. MUST equal MC_INTERNAL_TOKEN in
# ../mastercard/.env — otherwise live gateway calls 401 and silently fall back to demo.
GATEWAY_INTERNAL_TOKEN=replace-with-shared-internal-token

# Shared bearer token for the demo tier — REQUIRED, the stack refuses to start without it.
# Both BFFs demand it as `Authorization: Bearer <token>` on every route except /health, and
# the frontend image bakes it into its JS bundle at build time from this same variable.
#
# Generate one with:  openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
#
# Two things worth knowing before you change it:
#  - Rebuild ALL THREE images together (`docker compose up -d --build`). Rebuilding only the
#    BFFs leaves the SPA holding the old token and every call in the browser 401s.
#  - It ships inside the JS bundle, so anyone who can load the UI can read it. It keeps the
#    APIs off the open internet; it is not per-user authorization.
DEMO_API_TOKEN=replace-with-a-random-token

# Tenant the gateway resolves for these calls (the dev harness seeds `platform`).
GATEWAY_TENANT_ID=platform

# Per-capability live/demo switch. `live` proxies the real Mastercard sandbox via the
# gateway; `demo` synthesizes locally. Defaults below match docker-compose.yml.
XBS_QUOTE_MODE=demo
XBS_VALIDATION_MODE=live
XBS_BALANCES_MODE=live
XBS_PAYMENT_MODE=demo
XBS_STATUS_MODE=demo
