# mastercard-demo-stack — environment template. Copy to `.env` and fill in.
# The real `.env` is git-ignored (it carries a shared secret).

# Internal token the BFFs present to the gateway. MUST equal MC_INTERNAL_TOKEN in
# ../mastercard/.env — otherwise live gateway calls 401 and silently fall back to demo.
GATEWAY_INTERNAL_TOKEN=replace-with-shared-internal-token

# Shared bearer token for the demo tier — REQUIRED, the stack refuses to start without it.
# Both BFFs demand it as `Authorization: Bearer <token>` on every route except /health, and the
# frontend container reads it from this same variable at START (docker-entrypoint.sh writes it
# into /config.js) — it is NOT baked into the image.
#
# Generate one with:  openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
#
# Two things worth knowing before you change it:
#  - Rotating it is `docker compose up -d` — no rebuild of anything. All three services read it
#    from the environment at container start.
#  - It is served to the browser in /config.js, so anyone who can load the UI can read it. It
#    keeps the APIs off the open internet; it is not per-user authorization, and on its own it is
#    NOT SUFFICIENT — every route also needs a gate proof (see DEMO_GATE_SECRET below).
DEMO_API_TOKEN=replace-with-a-random-token

# Password for the UI access gate — REQUIRED, the stack refuses to start without it.
#
# This one is a REAL secret, unlike DEMO_API_TOKEN: it goes to app-bff only, it is checked
# server-side by `POST /demo-api/gate/verify`, and it is never served to the browser in any form.
# Do not add it to mastercard-bff or to the frontend.
#
# Rotating it is a restart of app-bff (`docker compose up -d`) — no rebuild, no frontend change.
DEMO_GATE_PASSWORD=replace-with-the-demo-access-password

# HMAC key for the access-gate proof — REQUIRED, the stack refuses to start without it.
#
# One value, TWO services: app-bff SIGNS a proof when the password checks out, and both BFFs then
# demand that proof on every route as a second factor alongside DEMO_API_TOKEN. This is what makes
# the gate a real boundary — the bearer token is public (it is in /config.js), the proof is not
# forgeable from anything the browser is given.
#
# ⚠️ The two services must hold the IDENTICAL value. If they drift, the dashboard keeps working
# while every cross-border page 401s — the same partial, confusing failure as
# GATEWAY_INTERNAL_TOKEN drifting from the gateway's MC_INTERNAL_TOKEN.
#
# Generate one with:  openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# Changing it invalidates every open session: users retype the password once.
DEMO_GATE_SECRET=replace-with-a-random-secret

# Optional. How long a gate proof stays valid, in hours. app-bff only; defaults to 12.
# There is no sliding refresh — on expiry the user retypes the password.
# DEMO_GATE_TTL_HOURS=12

# Tenant the gateway resolves for these calls (the dev harness seeds `platform`).
GATEWAY_TENANT_ID=platform

# Per-capability live/demo switch. `live` proxies the real Mastercard sandbox via the
# gateway; `demo` synthesizes locally. Defaults below match docker-compose.yml.
XBS_QUOTE_MODE=demo
XBS_VALIDATION_MODE=live
XBS_BALANCES_MODE=live
XBS_PAYMENT_MODE=demo
XBS_STATUS_MODE=demo
