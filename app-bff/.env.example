# app-bff configuration. All vars are optional — the defaults shown target the shared
# compose Postgres (its own `mc_demo` database). The app-bff is the permanent frontend
# backend (entity store + auth + integrations); it does NOT talk to Mastercard.

# --- runtime ---
NODE_ENV=development
PORT=4000

# --- API authentication (REQUIRED) ---
# Shared bearer token every caller must send as `Authorization: Bearer <token>`.
# Only /health is public (docker-compose's healthcheck depends on that).
# Unset = every request 401s; in production the service refuses to start at all.
# Generate one with:  openssl rand -base64 32
DEMO_API_TOKEN=replace-with-a-random-token

# Password typed into the UI's access gate, checked by `POST /gate/verify`.
# Unset = every attempt is rejected and the service logs loudly at boot; in production it refuses
# to start at all (same treatment as DEMO_API_TOKEN).
#
# This is the ONLY place the gate password lives. It is deliberately not a frontend variable:
# it used to be a constant in masrtercard-front/src/components/PasswordGate.jsx, which Vite
# inlined into the built bundle, so it shipped inside the published image. Keep it here.
DEMO_GATE_PASSWORD=replace-with-the-demo-access-password

# HMAC key for the gate proof this service issues once the password checks out. Both BFFs then
# require that proof on every route, as a second factor alongside DEMO_API_TOKEN.
#
# ⚠️ MUST be byte-identical to mastercard-bff's DEMO_GATE_SECRET — that service verifies the proofs
# this one signs. On drift the dashboard works and every cross-border page 401s.
# Unset = every route 401s; in production the service refuses to start.
# Generate one with:  openssl rand -base64 32
DEMO_GATE_SECRET=replace-with-a-random-secret

# Optional. Gate proof lifetime in hours; defaults to 12. No sliding refresh — on expiry the user
# retypes the password.
# DEMO_GATE_TTL_HOURS=12

# Comma-separated browser origins allowed to call this API cross-origin. Unset defaults to
# Vite's dev server (http://localhost:5173, http://127.0.0.1:5173). Irrelevant in the compose
# stack, where the SPA reaches this service same-origin through nginx.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- app data database (its OWN db `mc_demo`; never the gateway's `mc_gateway`) ---
DEMO_DB_HOST=postgres
DEMO_DB_PORT=5432
DEMO_DB_USER=mc
DEMO_DB_PASSWORD=mc
DEMO_DB_NAME=mc_demo
