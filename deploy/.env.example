# XBS Embedded — production deployment configuration.
#
# Copy to `.env` next to docker-compose.yml and fill in. Every line marked SECRET must come
# from a secrets manager or a secure channel — never from a repository, a chat message, or an
# image layer. Lines marked REQUIRED abort `docker compose up` when empty.
#
#   cp .env.example .env && $EDITOR .env
#   docker compose up -d
#
# ──────────────────────────────────────────────────────────────────────────────
# 1. Images
# ──────────────────────────────────────────────────────────────────────────────
# Registry path shared by all four images. Full names are
#   ${REGISTRY}/gateway  ${REGISTRY}/mastercard-bff  ${REGISTRY}/app-bff  ${REGISTRY}/frontend
REGISTRY=ghcr.io/migirov/mastercard
# REQUIRED. Pin an immutable version tag; `latest` moves under you between deployments.
IMAGE_TAG=v1.0.0

# ──────────────────────────────────────────────────────────────────────────────
# 2. Shared tokens (generate once: openssl rand -base64 32 | tr '+/' '-_' | tr -d '=')
# ──────────────────────────────────────────────────────────────────────────────
# SECRET, REQUIRED. Bearer token for the two BFF APIs; the frontend sends it on every call.
# One value for frontend + app-bff + mastercard-bff — they must not drift.
# It reaches the browser by design, so it is not a secret from users: it keeps the APIs off the
# open internet, it is NOT per-user authorization, and on its own it is NOT SUFFICIENT — every
# route also requires a gate proof (DEMO_GATE_SECRET below).
DEMO_API_TOKEN=
# SECRET, REQUIRED. Password typed into the UI's access gate. app-bff ONLY — it is verified
# server-side (POST /demo-api/gate/verify) and never reaches the browser, which is what makes it
# a real secret unlike DEMO_API_TOKEN above. This is NOT one of the six variables compose renames
# per service (see DEPLOY.md §3) — the name is the same everywhere it appears.
DEMO_GATE_PASSWORD=
# SECRET, REQUIRED. HMAC key for the gate proof. One value, TWO services: app-bff signs the proof
# on a correct password, mastercard-bff verifies it, and both demand it on every route.
# ⚠️ They must be IDENTICAL — on drift the dashboard works and every cross-border page 401s.
# Also not one of the six renamed names.
DEMO_GATE_SECRET=
# Optional. Gate proof lifetime in hours, app-bff only. Default 12. No sliding refresh.
# DEMO_GATE_TTL_HOURS=12
# SECRET, REQUIRED. Internal service token. Used as the gateway's MC_INTERNAL_TOKEN and as
# mastercard-bff's GATEWAY_INTERNAL_TOKEN — one value, both sides.
GATEWAY_INTERNAL_TOKEN=
# The gateway tenant the BFF calls under. `platform` is seeded automatically at first boot.
GATEWAY_TENANT_ID=platform

# ──────────────────────────────────────────────────────────────────────────────
# 3. Databases
# ──────────────────────────────────────────────────────────────────────────────
# Two databases on one Postgres server: `mc_gateway` (gateway) and `mc_demo` (app-bff).
# app-bff CREATEs its own on first boot, so the role needs CREATEDB — or pre-create `mc_demo`
# and grant the role on it.
#
# Managed instance (default): point these at it.
# In-stack Postgres instead:  docker compose --profile with-postgres up -d   (host `postgres`)
DB_USER=mc
# SECRET, REQUIRED.
DB_PASSWORD=
# REQUIRED. Full connection URL for the gateway.
GATEWAY_DATABASE_URL=postgres://mc:CHANGEME@your-db-host:5432/mc_gateway
GATEWAY_DB_NAME=mc_gateway
# REQUIRED. Host/port/name for app-bff (it takes parts, not a URL).
APP_DB_HOST=your-db-host
APP_DB_PORT=5432
APP_DB_NAME=mc_demo
# Connections PER CONTAINER for the gateway (containers × DB_POOL_MAX ≤ max_connections).
DB_POOL_MAX=10

# ──────────────────────────────────────────────────────────────────────────────
# 4. Mastercard API — gateway
# ──────────────────────────────────────────────────────────────────────────────
# REQUIRED. Sandbox / MTF / production base URL.
MC_BASE_URL=https://sandbox.api.mastercard.com
# Outbound auth scheme: oauth1 (default) | oauth2-request-token
# Customers contracted with Mastercard MTS EU / MTS UK must use the PSD2 edges and
# oauth2-request-token; everyone else stays on oauth1. Both modes use the SAME
# consumer key and the SAME signing .p12 — but in oauth2 mode that .p12 MUST also
# contain its certificate (the token carries the cert thumbprint).
#   sandbox  https://sandbox.api.xbs.mastercard.eu   (or .uk)
#   MTF      https://mtf.api.xbs.mastercard.eu       (or .uk)   — also needs mTLS
#   prod     https://api.xbs.mastercard.eu           (or .uk)   — also needs mTLS
# NB: sandbox.api.mastercard.eu WITHOUT the "xbs" segment is a decommissioned edge.
MC_AUTH_MODE=oauth1
# SECRET, REQUIRED. Consumer key from the Mastercard Developers portal.
MC_CONSUMER_KEY=
# REQUIRED. Sandbox uses the shared static SANDBOX_1234567; production uses your own.
MC_PARTNER_ID=SANDBOX_1234567

# --- OAuth1 signing key (a .p12 file in the mounted certs directory) ---
# REQUIRED. Path INSIDE the container; ./ resolves against /app, where certs/ is mounted.
MC_SIGNING_KEY_PATH=./certs/your-signing-key.p12
# SECRET, REQUIRED. Passphrase of that .p12.
MC_SIGNING_KEY_PASSWORD=

# --- Field-level encryption (JWE). Works in every environment including sandbox. ---
# Key direction, do not swap: encrypt REQUESTS with Mastercard's Client Encryption public cert,
# decrypt RESPONSES with our own Mastercard Encryption private key.
MC_ENCRYPTION_ENABLED=true
MC_ENCRYPTION_CERT_PATH=./certs/client-encryption-cert.pem
# 64-hex SHA-256 of the public encryption key — the `kid` sent on requests.
MC_ENCRYPTION_FINGERPRINT=
MC_DECRYPTION_KEY_PATH=./certs/client-encryption-private.pem

# --- Where per-merchant credentials live: local | aws-secrets-manager ---
# `local` reads a seeded/dev store. Production REQUIRES aws-secrets-manager (see §7).
MC_SECRET_STORE=local
# Optional; the AWS SDK otherwise uses AWS_REGION or the instance/task role.
MC_SECRET_STORE_REGION=

# ──────────────────────────────────────────────────────────────────────────────
# 5. Gateway auth tokens
# ──────────────────────────────────────────────────────────────────────────────
# SECRET, REQUIRED, min 16 chars. Signs the merchant-facing OAuth2 access tokens.
MC_JWT_SECRET=
# SECRET, REQUIRED. Admin API token (X-Admin-Token) — tenant provisioning.
MC_ADMIN_TOKEN=
# SECRET, optional. Secondary webhook factor for non-production. In production the
# authoritative factor is mTLS (§7) — Mastercard sends no token on push notifications.
MC_WEBHOOK_TOKEN=

# ──────────────────────────────────────────────────────────────────────────────
# 6. Runtime / network
# ──────────────────────────────────────────────────────────────────────────────
# Where certs are on the HOST. Delivered out of band; must exist before the first start.
CERTS_DIR=./certs
# Publish the UI. Loopback by default — terminate TLS in front (ALB / nginx / Cloudflare).
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=8080
# Number of proxy hops in front of the gateway (an ALB is 1). Empty = trust nothing.
# Wrong here means IP rate-limiting keys off the proxy instead of the client.
TRUST_PROXY=
# trace | debug | info | warn | error
LOG_LEVEL=info
# Swagger at /api-docs. On by default outside production; set to `true` to keep it in prod.
SWAGGER_ENABLED=

# ──────────────────────────────────────────────────────────────────────────────
# 7. Production gates — leave EMPTY for the first deployment
# ──────────────────────────────────────────────────────────────────────────────
# Setting GATEWAY_NODE_ENV=production makes the gateway refuse to start unless ALL of the
# following hold. This is deliberate; read DEPLOY.md §"Production checklist" before flipping it.
#   - MC_JWT_SECRET / MC_INTERNAL_TOKEN / MC_ADMIN_TOKEN / MC_WEBHOOK_TOKEN are strong
#   - MC_SECRET_STORE=aws-secrets-manager, with the task/instance role able to read them
#   - MC_ENCRYPTION_ENABLED=true
#   - MC_WEBHOOK_MTLS_ENABLED=true with both CN allowlists set
#   - TLS_KEY_PATH and TLS_CERT_PATH set (the app terminates TLS itself; ingress is L4
#     passthrough, so it can validate Mastercard's client certificate)
GATEWAY_NODE_ENV=
BFF_NODE_ENV=
MC_WEBHOOK_MTLS_ENABLED=false
# Production: CrossborderServicesNotification-prod.mastercard.com · MTF: …-mtf.mastercard.com
MC_WEBHOOK_ALLOWED_CLIENT_CNS=
# Issuer (CA) CN allowlist — pins who signed the client cert. Mastercard outbound issuer per
# their docs: DigiCert Assured ID Client CA G2
MC_WEBHOOK_ALLOWED_ISSUER_CNS=
TLS_KEY_PATH=
TLS_CERT_PATH=
TLS_CLIENT_CA_PATH=

# ──────────────────────────────────────────────────────────────────────────────
# 8. Live / demo switches (mastercard-bff)
# ──────────────────────────────────────────────────────────────────────────────
# `live` = real Mastercard call through the gateway; `demo` = synthesized response. Defaults
# reflect what the Mastercard SANDBOX supports today. Flip to `live` as MTF/Production enables
# each capability — restart only, no rebuild. Every response carries a `source` field.
XBS_VALIDATION_MODE=live
XBS_BALANCES_MODE=live
XBS_BANK_LOOKUP_MODE=live
XBS_IBAN_MODE=live
XBS_CASH_PICKUP_MODE=live
XBS_QUOTE_MODE=demo
XBS_PAYMENT_MODE=demo
XBS_STATUS_MODE=demo
XBS_RATES_MODE=demo
XBS_ENDPOINT_GUIDE_MODE=demo
XBS_QUOTE_LIFECYCLE_MODE=demo
XBS_PAYMENT_TRACKER_MODE=demo
XBS_RFI_MODE=demo

# --- Outbound mTLS: the client certificate WE PRESENT to Mastercard ---
# Not needed on sandbox.api.xbs.*; REQUIRED on mtf.api.xbs.* and api.xbs.* — the
# gateway refuses to start on those hosts without it. Issued through Mastercard's
# Key Management Portal (Mastercard Connect): needs two active Security Officers in
# your organisation plus a certificate-management group e-mail; CSR CN is "MTF XBS"
# or "PROD XBS". Lead time is weeks — start before you need the environment.
# Mount the .p12 into the same certs/ volume as the signing key.
MC_MTLS_ENABLED=false
MC_MTLS_CLIENT_CERT_PATH=/app/certs/mc-mtls-client.p12
MC_MTLS_CLIENT_CERT_PASSWORD=
# Optional extra trust anchors for MASTERCARD'S server certificate; usually empty.
MC_MTLS_CA_PATH=
